{
  "app": {
    "name": "AI 歌手直播控制台",
    "theme": "dark"
  },
  "cloud": {
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "",
      "model": "deepseek-chat",
      "temperature": 0.8,
      "maxTokens": 400,
      "timeoutMs": 30000,
      "systemPrompt": "你是一位虚拟歌手，性格活泼真诚，正在直播间和观众聊天。回答口语化、简短（1-3 句），不要使用 Markdown、列表或舞台提示，不要输出表情符号以外的特殊符号。"
    },
    "tts": {
      "provider": "edge-tts",
      "pythonPath": "tools/pyenv/Scripts/python.exe",
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "+0%",
      "volume": "+0%",
      "outputDir": "data/audio"
    },
    "autoDL": {
      "provider": "AutoDL",
      "endpoint": "",
      "apiKey": "",
      "repoUrl": "",
      "branch": "main",
      "dataCenter": "westDC3",
      "gpuSpec": "4090D",
      "imageUuid": "",
      "vramMb": 0,
      "instances": {}
    }
  },
  "services": [
    {
      "id": "danmu",
      "name": "弹幕获取（抖音）",
      "role": "interact",
      "mode": "local",
      "cwd": "tools/danmu-service",
      "python": "tools/danmuenv/Scripts/python.exe",
      "args": ["danmu_service.py", "--port", "7864"],
      "port": 7864,
      "healthPath": "/health",
      "autoStart": false,
      "startupTimeoutMs": 30000,
      "cloud": { "endpoint": "", "apiKey": "" }
    },
    {
      "id": "realtime",
      "name": "MuseTalk 实时互动",
      "role": "interact",
      "mode": "local",
      "cwd": "tools/MuseTalk",
      "python": "tools/museenv/Scripts/python.exe",
      "args": ["scripts/realtime_service.py", "--port", "7863"],
      "port": 7863,
      "healthPath": "/health",
      "autoStart": true,
      "startupTimeoutMs": 120000,
      "cloud": { "endpoint": "", "apiKey": "" }
    },
    {
      "id": "latentsync",
      "name": "LatentSync 口型驱动",
      "role": "interact",
      "mode": "local",
      "cwd": "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\LatentSync",
      "python": "C:\\Users\\Administrator\\miniconda3\\envs\\latentsync\\python.exe",
      "envPaths": [
        "C:\\Users\\Administrator\\miniconda3\\envs\\latentsync",
        "C:\\Users\\Administrator\\miniconda3\\envs\\latentsync\\Library\\bin",
        "C:\\Users\\Administrator\\miniconda3\\envs\\latentsync\\Scripts"
      ],
      "args": ["gradio_app.py", "--port", "7860"],
      "port": 7860,
      "healthPath": "/",
      "autoStart": false,
      "startupTimeoutMs": 180000,
      "cloud": { "endpoint": "", "apiKey": "" }
    },
    {
      "id": "svs",
      "name": "SoulX-Singer 歌声合成",
      "role": "song",
      "mode": "local",
      "cwd": "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\SoulX-Singer",
      "python": "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\python.exe",
      "envPaths": [
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger",
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Library\\bin",
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Scripts"
      ],
      "args": ["webui.py", "--port", "7861", "--fp16"],
      "port": 7861,
      "healthPath": "/",
      "autoStart": false,
      "startupTimeoutMs": 240000,
      "cloud": { "endpoint": "", "apiKey": "" }
    },
    {
      "id": "svc",
      "name": "SoulX-Singer 音色转换",
      "role": "song",
      "mode": "local",
      "cwd": "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\SoulX-Singer",
      "python": "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\python.exe",
      "envPaths": [
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger",
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Library\\bin",
        "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Scripts"
      ],
      "args": ["webui_svc.py", "--port", "7862", "--fp16"],
      "port": 7862,
      "healthPath": "/",
      "autoStart": false,
      "startupTimeoutMs": 240000,
      "cloud": { "endpoint": "", "apiKey": "" }
    }
  ],
  "orchestrator": {
    "idleAfterInteractSec": 0,
    "autoDegradeAfterFailures": 3
  },
  "stream": {
    "track": "file",
    "ffmpegPath": "C:\\Users\\Administrator\\miniconda3\\envs\\latentsync\\lib\\site-packages\\imageio_ffmpeg\\binaries\\ffmpeg-win64-v4.2.2.exe",
    "rtmpUrl": "",
    "videoSource": "",
    "fps": 30,
    "width": 1280,
    "height": 720,
    "bitrate": "3500k",
    "preset": "veryfast"
  },
  "queue": {
    "maxConcurrent": 1,
    "simulate": false,
    "outputDir": "data/renders"
  },
  "muse": {
    "pythonPath": "tools/museenv/Scripts/python.exe",
    "repoDir": "tools/MuseTalk",
    "ffmpegPath": "tools/ffmpeg",
    "version": "v15",
    "avatar": "tools/MuseTalk/data/video/yongen.mp4",
    "batchSize": 4,
    "fps": 25,
    "extraMargin": 10,
    "useFloat16": true
  },
  "voice": {
    "consistencyEnabled": true
  },
  "soulx": {
    "pythonPath": "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\python.exe",
    "repoDir": "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\SoulX-Singer",
    "envPaths": [
      "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger",
      "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Library\\bin",
      "C:\\Users\\Administrator\\miniconda3\\envs\\soulxsinger\\Scripts"
    ],
    "modelPath": "pretrained_models/SoulX-Singer/model.pt",
    "svcModelPath": "pretrained_models/SoulX-Singer/model-svc.pt",
    "voiceDir": "data/voices",
    "modelConfig": "soulxsinger/config/soulxsinger.yaml",
    "phoneset": "soulxsinger/utils/phoneme/phone_set.json",
    "promptWav": "example/audio/zh_prompt.mp3",
    "promptMeta": "example/audio/zh_prompt.json",
    "language": "Mandarin",
    "device": "cuda",
    "control": "score",
    "pitchShift": 0,
    "maxMergeDuration": 60000,
    "fp16": true
  },
  "realtime": {
    "port": 7863,
    "avatarId": "yongen",
    "gpuLockFile": "tools/MuseTalk/results/_realtime/gpu.lock",
    "timeoutMs": 600000
  },
  "danmu": {
    "port": 7864,
    "autoReply": false,
    "cooldownSec": 30,
    "maxQueue": 10,
    "giftThanks": true,
    "pollMs": 2000
  },
  "library": {
    "roots": [
      "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\output",
      "C:\\Users\\Administrator\\Documents\\Trae-CN\\temp_20261016_01\\samples",
      "data/renders"
    ],
    "extensions": [".mp4", ".mov", ".mkv", ".wav", ".mp3"]
  }
}
